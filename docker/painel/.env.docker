# Ambiente do painel DENTRO do docker-compose.yml da raiz. Só valores de dev.
#
# O compose monta este arquivo POR CIMA de painel/.env dentro do container: o
# .env da sua máquina (que pode apontar para Neon e R2 de produção) nunca é lido
# pelo stack. Sem isso, qualquer variável esquecida aqui cairia no valor de
# produção.
#
# Fica fora de painel/ de propósito: tudo em painel/ entra na imagem do Render.

APP_NAME=Laravel
APP_ENV=local
# Chave só de dev: cifra sessões e cookies locais. Nunca vai para produção.
APP_KEY=base64:gPXGusP1y3hnb23o6z60xzDv/ExwBguysmc49dxI8Z8=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr: os logs aparecem em `docker compose logs painel`, não num arquivo.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Postgres do compose, pela rede interna do Docker (serviço "postgres", porta 5432
# do container; a 5433 é só a porta do host).
# DB_USERNAME é o papel da aplicação, preso à RLS.
# DB_OWNER_* é o dono das tabelas: só migrations e seed (--database=pgsql_owner).
# DB_PLATFORM_* tem BYPASSRLS: só o painel /plataforma usa.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=la_carte
DB_SSLMODE=disable
DB_USERNAME=la_carte_app
DB_PASSWORD=la_carte_app_dev
DB_OWNER_USERNAME=la_carte
DB_OWNER_PASSWORD=la_carte_dev
DB_PLATFORM_USERNAME=la_carte_platform
DB_PLATFORM_PASSWORD=la_carte_platform_dev

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Fotos: original no disco public (storage/app/public, servido em /storage);
# WebP também no public, como no dev do host.
MEDIA_DISK=public

# Snapshots no MinIO do compose.
# AWS_ENDPOINT: como o CONTAINER fala com o MinIO (rede interna).
# AWS_URL: como o NAVEGADOR chega nos arquivos. É o que vai gravado no snapshot.
SNAPSHOT_DISK=s3
AWS_ACCESS_KEY_ID=la_carte
AWS_SECRET_ACCESS_KEY=la_carte_dev
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=la-carte
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://127.0.0.1:9000/la-carte
